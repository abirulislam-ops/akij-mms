{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "seed/**/*.ts", "packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "apps/api/src/**/*.ts"],
  "exclude": ["node_modules", "neon.ts", "hello.ts"]
}
